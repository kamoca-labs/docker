{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/rules/compose-name.ts\"",
            "timeout": 10,
            "statusMessage": "docker:compose-name: name: first key in the compose file"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/rules/service-name.ts\"",
            "timeout": 10,
            "statusMessage": "docker:service-name: service named after the technology"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/rules/service-build.ts\"",
            "timeout": 10,
            "statusMessage": "docker:service-build: every service has a Dockerfile"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/rules/container-name.ts\"",
            "timeout": 10,
            "statusMessage": "docker:container-name: container_name = project + service"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/rules/dev-user.ts\"",
            "timeout": 10,
            "statusMessage": "docker:dev-user: dev uses the host UID/GID"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/rules/bind-volumes.ts\"",
            "timeout": 10,
            "statusMessage": "docker:bind-volumes: volumes in a local folder"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/rules/single-env.ts\"",
            "timeout": 10,
            "statusMessage": "docker:single-env: one .env per environment"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/rules/var-defaults.ts\"",
            "timeout": 10,
            "statusMessage": "docker:var-defaults: default in every variable"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/rules/docker-folder.ts\"",
            "timeout": 10,
            "statusMessage": "docker:docker-folder: compose in the root, the rest in docker/<domain>"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/rules/dockerignore.ts\"",
            "timeout": 10,
            "statusMessage": "docker:dockerignore: dockerignore without secrets or data"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/rules/http3.ts\"",
            "timeout": 10,
            "statusMessage": "docker:http3: HTTP/2 and HTTP/3 on the HTTP server"
          }
        ]
      }
    ]
  }
}
